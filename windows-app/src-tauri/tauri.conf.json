{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimezoneClock",
  "version": "0.1.0",
  "identifier": "dev.aetherallan.timezoneclock.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TimezoneClock",
        "width": 360,
        "height": 550,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
